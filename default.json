{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Política GUNDO: seguridad inmediata por Dependabot y mantenimiento rutinario agrupado con coste controlado.",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "timezone": "America/Bogota",
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "minimumReleaseAge": "3 days",
  "automerge": false,
  "major": {
    "dependencyDashboardApproval": true
  },
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on the first day of the month"
    ]
  }
}
